---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer mono">
  <span>© {year} {site.name}</span>
  <span class="quote">"{site.quote}" — {site.quoteBy}</span>
  <a href="#" class="top" aria-label="回到頂端">↑ TOP</a>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 22px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }

  .quote {
    flex: 1;
    text-align: center;
  }

  .top:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .quote {
      order: 3;
      flex-basis: 100%;
      text-align: left;
    }
  }
</style>
