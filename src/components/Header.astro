---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')));
---

<header class="site-header">
  <a href="/" class="brand mono" aria-label="回首頁">
    <span class="mark">V</span>
    <span class="name">{site.name.toUpperCase()}</span>
    <span class="cursor">_</span>
  </a>

  <nav class="nav" aria-label="主選單">
    {
      nav.map((item, i) => (
        <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]}>
          <span class="nav-idx">{String(i).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <button class="theme-toggle" type="button" aria-label="切換深色 / 淺色模式" title="切換深色 / 淺色模式">
    <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
  </button>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    font-size: 13px;
    letter-spacing: 0;
    color: var(--accent);
  }

  .cursor {
    margin-left: -8px;
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav-item {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 10px;
    font-size: 14px;
    color: var(--muted);
    border-radius: var(--radius);
    transition: color 0.15s, background 0.15s;
  }

  .nav-idx {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--line-strong);
    transition: color 0.15s;
  }

  .nav-item:hover {
    color: var(--text);
  }

  .nav-item.active {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-item.active .nav-idx,
  .nav-item:hover .nav-idx {
    color: var(--accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(:root[data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }

  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
      height: auto;
      padding-top: 12px;
      gap: 10px 16px;
    }

    .theme-toggle {
      margin-left: auto;
    }

    .nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: 6px var(--gutter);
      border-top: 1px solid var(--line);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-item {
      flex-shrink: 0;
      font-size: 13.5px;
    }
  }
</style>
