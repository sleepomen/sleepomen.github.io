---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';
import { formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
---

<Base title={post.data.title} description={post.data.description}>
  <header class="page-head">
    <a class="label back" href="/blog/">← Blog</a>
    <h1>{post.data.title}</h1>
    <div class="meta mono">
      <span>{formatDate(post.data.date)}</span>
      {post.data.tags.map((t) => <span class="chip">#{t}</span>)}
    </div>
  </header>

  <section class="section article">
    <article class="prose">
      <Content />
    </article>

    {
      toc.length > 0 && (
        <aside class="toc">
          <div class="label">Contents</div>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </section>

  {
    (newer || older) && (
      <nav class="pager">
        {older ? (
          <a href={`/blog/${older.id}/`}>
            <span class="label">← Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="right" href={`/blog/${newer.id}/`}>
            <span class="label">Newer →</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }

  <Giscus />
</Base>

<style>
  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
  }

  .toc {
    position: sticky;
    top: 84px;
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }

  .toc ol {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .toc li {
    margin: 6px 0;
  }

  .toc .d3 {
    padding-left: 12px;
  }

  .toc a {
    color: var(--muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px var(--gutter);
    transition: background 0.15s;
  }

  .pager a:hover {
    background: var(--surface);
  }

  .pager .right {
    text-align: right;
    border-left: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .article {
      grid-template-columns: 1fr;
    }

    .toc {
      display: none;
    }
  }
</style>
