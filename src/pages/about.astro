---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Giscus from '../components/Giscus.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { site, skills, contacts } from '../data/site';
---

<Base title="關於" description={site.intro}>
  <header class="page-head">
    <div class="label">// 01 — About</div>
    <h1>關於我</h1>
    <p>「{site.slogan}」</p>
  </header>

  <section class="section">
    <div class="profile card">
      <div class="profile-side">
        <img src={site.avatar} alt={site.name} width="128" height="128" />
        <dl class="mono">
          <dt>NAME</dt><dd>{site.name}</dd>
          <dt>STATUS</dt><dd>{site.description}</dd>
          <dt>MOTTO</dt><dd>{site.slogan}</dd>
        </dl>
      </div>
      <div class="profile-main">
        <div class="label">README.md</div>
        <p>{site.intro}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHead idx="A" title="技能" en="Skills" />
    <div class="chips">{skills.map((s) => <span class="chip">{s.icons.map((i) => <BrandIcon icon={i} />)}{s.label}</span>)}</div>
  </section>

  <section class="section">
    <SectionHead idx="B" title="聯絡" en="Contact" />
    <div class="chips">
      {contacts.map((c) => <a class="chip" href={c.href} target="_blank" rel="noopener"><BrandIcon icon={c.icon} />{c.label} ↗</a>)}
    </div>
  </section>

  <Giscus />
</Base>

<style>
  .profile {
    display: grid;
    grid-template-columns: 260px 1fr;
  }

  .profile-side {
    padding: 24px;
    border-right: 1px solid var(--line);
  }

  .profile-side img {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    padding: 4px;
    margin-bottom: 20px;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    margin: 0;
    font-size: 12.5px;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .profile-main {
    padding: 24px clamp(20px, 4vw, 40px);
  }

  .profile-main .label {
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 1px dashed var(--line);
  }

  .profile-main p {
    color: var(--text-2);
    line-height: 1.95;
  }

  @media (max-width: 720px) {
    .profile {
      grid-template-columns: 1fr;
    }

    .profile-side {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
